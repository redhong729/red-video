# 本地开发示例；不要用于生产环境。
DATABASE_URL="postgresql://red_video:local_dev_password@localhost:5432/red_video?schema=public"
# API 仅监听本机；不设置时默认 4000。
PORT=4000
# 后台浏览器地址，需与实际访问的协议、主机和端口完全一致。
ADMIN_ORIGIN="http://127.0.0.1:3001"

# 本地媒体目录（相对于 backend/api）；内容不应提交到仓库。
MEDIA_STORAGE_DIR="../../storage"
MEDIA_MAX_FILES=50
MEDIA_MAX_BYTES=1073741824
MEDIA_CHUNK_BYTES=5242880
MEDIA_UPLOAD_DAYS=7
